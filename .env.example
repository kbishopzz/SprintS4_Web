# Vite React Frontend Environment Variables
# Copy this file to .env or .env.local for custom environment configuration.

# Backend Spring Boot API Base URL
VITE_API_BASE_URL=http://localhost:8080

# Keycloak Authentication (default: local Keycloak on port 8180)
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=airport-realm
VITE_KEYCLOAK_CLIENT_ID=admin-portal
